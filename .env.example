# Crash-to-Contact — Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored and must NEVER be committed.

# Census ACS API key (required for ACS 5-year enrichment)
# Free signup: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Socrata app token (optional — lifts anonymous throttling on MoCo SODA API)
# Register at: https://data.montgomerycountymd.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
